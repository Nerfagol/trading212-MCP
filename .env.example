# Generate a separate key pair in the Trading 212 environment selected below.
T212_API_KEY=replace-with-your-api-key
T212_API_SECRET=replace-with-your-api-secret
T212_ENV=demo

# Safe local default. On QNAP, set this to the NAS's fixed LAN IP.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8000

# Add the QNAP LAN IP with :* before exposing the port on the LAN.
# Example: ...,192.168.1.50:*
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,trading212-mcp:*

# Non-browser MCP clients normally send no Origin header. Add only exact browser
# origins you trust if a browser-based client requires them.
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

